# Root module sketch: AWS provider without credentials in HCL.
# On HCP Terraform remote runs, set workspace env vars (dynamic or static) — see provider-credentials.md.
# Not loaded by Terraform in this study tree.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "aws_region" {
  type    = string
  default = "eu-west-1"
}

provider "aws" {
  region = var.aws_region
}

resource "aws_s3_bucket" "example" {
  bucket = var.bucket_name
}

variable "bucket_name" {
  type = string
}
