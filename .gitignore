# Local working directory Terraform creates on init
.terraform/

# State holds real resource IDs and often plaintext secrets
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans can contain sensitive values
*.tfplan
tfplan
tfplan.*

# Crash logs can contain sensitive values
crash.log
crash.*.log

# Local overrides are machine-specific
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl. It pins provider versions for everyone else.

# Verbose logs from local debugging (can contain secrets)
terraform.log
*.log

# Generated by apply in example directories (safe to recreate)
04-configuration/04e-expressions-and-functions/rendered.txt
04-configuration/04g-custom-conditions/app.txt
05-modules/05c-use-modules/modules/pet/*.txt