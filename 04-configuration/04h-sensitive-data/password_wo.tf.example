# Sketch of a write-only argument. Needs the AWS provider and a real account.
# Shown so the password_wo / password_wo_version pair is familiar.
# Terraform 1.11+ sends password_wo to the provider and does not store it.
# Increment password_wo_version to rotate the password.

terraform {
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}

ephemeral "random_password" "db" {
  length  = 20
  special = false
}

resource "aws_db_instance" "app" {
  identifier          = "app"
  engine              = "postgres"
  instance_class      = "db.t3.micro"
  allocated_storage   = 20
  username            = "app"
  skip_final_snapshot = true

  password_wo         = ephemeral.random_password.db.result
  password_wo_version = 1
}
